[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://src/render/post_stack.gd" id="1_post"]
[ext_resource type="Shader" path="res://src/render/post.gdshader" id="2_shader"]
[ext_resource type="Resource" path="res://src/render/render_tuning.tres" id="3_tuning"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_post"]
shader = ExtResource("2_shader")

; Layer 0: above the 3D scene, below the HUD (layer 1) and the pause menu
; (layer 3). The interface is deliberately not graded or grained.
[node name="PostStack" type="CanvasLayer"]
layer = 0
script = ExtResource("1_post")
tuning = ExtResource("3_tuning")

[node name="Screen" type="ColorRect" parent="."]
material = SubResource("ShaderMaterial_post")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
