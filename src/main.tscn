; Protocol 4.4, and the only thing in the game that is true of the run rather
; than of an act. Concluded in the annex, read in the control house, which are
; two different scenes.
[node name="Run" type="Node" parent="." groups=["saveable", "run_state"]]
script = ExtResource("20_run")

[node name="Journal" type="Node" parent="." groups=["saveable"]]
script = ExtResource("16_journal")
index = ExtResource("19_docs")

[node name="Score" type="Node" parent="." groups=["score"]]
script = ExtResource("13_score")
tuning = ExtResource("14_scoretune")

; Exactly one act is mounted at a time; this is what swaps them. The first is
; placed by hand below so that opening the project shows a level rather than an
; empty root, and the runner adopts it. See ActRunner.
[node name="Acts" type="Node" parent="." groups=["act_runner"]]
script = ExtResource("17_runner")
acts = Array[PackedScene]([ExtResource("2_room"), ExtResource("18_shelter")])
mount = NodePath("..")

[node name="Powerhouse" parent="." instance=ExtResource("2_room")]

; Fourteen fifty-two. Four hours into the survey, standing two and a half metres
; off panel DP-1 with a torch on it, which is where an auditor writing a
; condition survey would be when the bus drops -- and, not by accident, close
; enough that the first puzzle is in the light the player already has. The
; alternative was making the torch brighter, which would have been a lighting
; answer to a level-design problem. See DECISIONS.md D25.
[node name="Player" parent="." instance=ExtResource("3_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 0.1, -2.5)

[node name="PostStack" parent="." instance=ExtResource("10_post")]

[node name="Hud" parent="." instance=ExtResource("4_hud")]

[node name="Reader" parent="." instance=ExtResource("15_reader")]

[node name="PauseMenu" parent="." instance=ExtResource("5_menu")]
