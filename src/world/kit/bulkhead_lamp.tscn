[gd_scene load_steps=10 format=3]

[ext_resource type="Material" path="res://assets/materials/graybox_steel.tres" id="1_steel"]
[ext_resource type="Material" path="res://assets/materials/graybox_lamp_glass.tres" id="2_glass"]
[ext_resource type="AudioStream" path="res://assets/audio/mach_ballast.wav" id="3_hum"]
[ext_resource type="Script" path="res://src/audio/occluder.gd" id="4_occl"]
[ext_resource type="Script" path="res://src/world/kit/bulkhead_lamp.gd" id="5_lamp"]
