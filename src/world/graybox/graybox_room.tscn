; Audible only near the lamp: walking away from it is the check that 3D
; attenuation is working as well as that the context unlocked.
; The ballast hum, generated by tools/audio/make_audio.py rather than
; synthesised in GDScript -- which is what the P0 note on lamp_hum.gd said would
; happen in P3. It keeps the audio_probe group, because the browser suite proves
; audio is running by watching this playback head advance.
[node name="Hum" type="AudioStreamPlayer3D" parent="BulkheadLamp" groups=["audio_probe"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.3, 0, 0)
stream = ExtResource("4_hum")
volume_db = -13.0
autoplay = true
bus = &"SFX"
unit_size = 3.4
max_db = 0.0
attenuation_filter_cutoff_hz = 20500.0

[node name="Occluder" type="Node" parent="BulkheadLamp/Hum"]
script = ExtResource("8_occl")

[node name="Light" type="OmniLight3D" parent="BulkheadLamp" groups=["practical"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.42, 0, 0)
light_color = Color(1, 0.706, 0.42, 1)
light_energy = 4.2
light_specular = 0.3
shadow_enabled = true
shadow_bias = 0.04
omni_range = 14.0
omni_attenuation = 1.6

; On the north wall, facing the spawn: the player is looking straight at it and
; has to walk the length of the room to reach it. That is the whole gray-box
; loop -- walk, look, engage -- in one object.
[node name="DialLock" parent="." instance=ExtResource("5_lock")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 1.55, -4.46)

; Non-positional: room tone is the room, not a thing in it.
[node name="RoomTone" type="AudioStreamPlayer" parent="."]
stream = ExtResource("7_tone")
volume_db = -19.0
autoplay = true
bus = &"SFX"

; Covers the interior. Mask 2 is the player layer; the zone detects the listener
; walking in and takes over the one reverb on the SFX bus.
[node name="Reverb" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.7, 0)
collision_layer = 0
collision_mask = 2
script = ExtResource("9_verb")
room_size = 0.72
damping = 0.42
wet = 0.24
predelay_msec = 34.0

[node name="Shape" type="CollisionShape3D" parent="Reverb"]
shape = SubResource("BoxShape3D_reverb")

; On the north wall beside the lock, where a laminated operating card would be:
; at the panel it describes.
[node name="SequenceCard" parent="." instance=ExtResource("12_page")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.5, 1.5, -4.44)
document = ExtResource("13_seqcard")
prompt_override = "Read the card"
