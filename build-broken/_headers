# Cloudflare Pages header rules. Later matching rules win, so the broad
# extension rules come first and the specific must-revalidate files come last.
#
# The engine payload (index.<hash>.wasm/.pck/.js) is content-addressed by
# tools/ci/postprocess_web.py, which is what makes `immutable` safe here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/*.pck
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400

# --- always revalidated: these decide which build is live --------------------

/
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, must-revalidate

/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, must-revalidate

/index.offline.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, must-revalidate

/index.service.worker.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache, must-revalidate

/index.manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache, must-revalidate
