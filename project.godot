; Engine configuration file for "Is There a Way?"
;
; Hand-editable on purpose. Every value here is either a hard constraint of the
; single-threaded WebGL2 target (see docs/BUDGETS.md) or a documented decision
; in docs/ARCHITECTURE.md. Gameplay feel does NOT live here -- it lives in
; tuning Resources under src/, so it can be edited in the inspector.

config_version=5

[application]

config/name="Is There a Way?"
config/description="A decommissioned lock-and-dam on the Mississippi seals itself with you below grade."
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icons/icon_512.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
run/max_fps=60

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=592
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 0 = Landscape. Decision: two-thumb first-person control needs horizontal
; thumb separation, and horror framing is horizontal. See docs/DECISIONS.md.
window/handheld/orientation=0
; iPhone renders at 3x. Rendering the 3D scene at CSS-pixel resolution is the
; single biggest frame-time win available on this target and costs us nothing
; visually once the grain/dither post stack lands in P2.
window/dpi/allow_hidpi=false
window/vsync/vsync_mode=1

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
