[gd_resource type="Resource" script_class="Document" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/document.gd" id="1_doc"]

[resource]
script = ExtResource("1_doc")
id = &"d08_ration_card"
title = "Ration rotation"
byline = "index card, pencil, taped inside the store room door"
hand = 1
body = "14 DAY CYCLE — ONE

EVERY DAY
BISCUIT 3, WATER 2 QT

SUPPLEMENT 1 TIN
EXCEPT DAYS 3, 7, 10 AND 14

SHORT DAYS, BISCUIT 2
DAYS 5 AND 12

ROTATE FRONT TO BACK. OLDEST FORWARD.
CARTONS 1962 STOCK STILL GOOD, TESTED.

CYCLE BEGAN   02 MAR 98
NEXT ROTATION 16 MAR 98"
