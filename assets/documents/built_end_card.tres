[gd_resource type="Resource" script_class="Document" load_steps=2 format=3]

; The edge of what is built. The one piece of text in this game that addresses
; the player, and it is allowed to because it is not in the world: everything
; the fiction says is said by somebody who was not talking to you.
;
; Shown when Reel 9-C is in hand, which is where Act Three ends.

[ext_resource type="Script" path="res://src/core/document.gd" id="1_doc"]

[resource]
script = ExtResource("1_doc")
id = &"built_end_card"
title = "End of Act Three"
byline = "This is the edge of what is built, not the end of the story."
hand = 0
body = "The reel in your hand is Run 9, box C. The last
thing anybody recorded in this building.

Act Four is the gate piers and the control
house, up inside the dam, and it is not made
yet. There is a way out of here and you have
not found it.

What you have just played is three acts: the
powerhouse, the shelter, and the annex.
Twelve puzzles, twenty-two documents, and one
man who has been keeping the log since 1994,
rotating the rations, and standing at the lamp.

If you read everything, you know his name, you
know what the programme was for, and you know
what Protocol 4.2 means. You do not yet know
what he says on the tape.

Put this down to go back."
