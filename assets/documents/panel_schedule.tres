[gd_resource type="Resource" script_class="Document" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/core/document.gd" id="1_doc"]

[resource]
script = ExtResource("1_doc")
id = &"d04a_panel_schedule"
title = "Panel schedule, DP-1"
byline = "Printed card behind the panel door. 1954, and corrected twice in pencil."
hand = 3
body = "PANEL DP-1\n125 VDC EMERGENCY LIGHTING\n\nMAIN, 60 A\nthe bus\n\nLT-1, 20 A\ngenerator hall\n\nLT-2, 20 A\nswitchgear rm / office\n\nLT-3, 20 A\nspare\n\nLT-4, 20 A\ngallery\n\nLT-5, 20 A\nspare\n\nLT-6, 20 A\nstair twr\n\nCLOSE MAIN LAST.\nIF MAIN WILL NOT HOLD, CLEAR THE FAULTED\nCIRCUIT AND RE-CLOSE."
