[gd_resource type="Resource" script_class="Document" load_steps=2 format=3]

; A chapter break, not a document and not the edge of anything. Act One hands
; on to Act Two: the shelter is behind the door the player just came through,
; and it is built. Kept deliberately short -- the game does not narrate itself,
; and a card between two acts that both exist has nothing to explain.

[ext_resource type="Script" path="res://src/core/document.gd" id="1_doc"]

[resource]
script = ExtResource("1_doc")
id = &"act_end_card"
title = "End of Act One"
byline = "The powerhouse is behind you."
hand = 0
body = "Act Two — The Shelter

Put this down to go on."
