[sub_resource type="Resource" id="Row_brightness"]
script = ExtResource("1_row")
key = &"brightness"
label = "Brightness"
hint = "Raise it only as far as you must. The dark is the game."
group = "Display"
default_value = 1.0
minimum = 0.6
maximum = 1.6
step = 0.02

[sub_resource type="Resource" id="Row_field_of_view"]
script = ExtResource("1_row")
key = &"field_of_view"
label = "Field of view"
hint = "Wider sees more of the room and less of what is far away."
group = "Display"
default_value = 72.0
minimum = 60.0
maximum = 90.0
step = 1.0
display_scale = 1.0
display_suffix = "°"

[sub_resource type="Resource" id="Row_reduce_motion"]
script = ExtResource("1_row")
key = &"reduce_motion"
label = "Reduce motion"
hint = "Removes head bob and camera easing."
group = "Display"
kind = 0
default_value = 0.0

[sub_resource type="Resource" id="Row_subtitle_size"]
script = ExtResource("1_row")
key = &"subtitle_size"
label = "Subtitle size"
group = "Accessibility"
kind = 2
default_value = 1.0
choices = PackedStringArray("Small", "Normal", "Large", "Very large")

[sub_resource type="Resource" id="Row_cue_mode"]
script = ExtResource("1_row")
key = &"cue_mode"
label = "Puzzle cues"
hint = "Adds a shape to every cue that is otherwise only a colour."
group = "Accessibility"
kind = 2
default_value = 0.0
choices = PackedStringArray("Colour", "Colour and shape")

