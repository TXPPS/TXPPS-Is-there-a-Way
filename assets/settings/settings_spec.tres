[gd_resource type="Resource" script_class="SettingsSpec" format=3]

[ext_resource type="Script" path="res://src/core/settings_row.gd" id="1_row"]
[ext_resource type="Script" path="res://src/core/settings_spec.gd" id="2_spec"]

[sub_resource type="Resource" id="Row_look_style"]
script = ExtResource("1_row")
key = &"look_style"
label = "Look style"
hint = "Right stick is two fixed thumbs. Drag is more precise."
group = "Controls"
kind = 2
default_value = 0.0
choices = PackedStringArray("Right stick", "Drag")

[sub_resource type="Resource" id="Row_look_sensitivity_x"]
script = ExtResource("1_row")
key = &"look_sensitivity_x"
label = "Turn speed"
hint = "How fast the camera turns left and right."
group = "Controls"
default_value = 1.0
minimum = 0.3
maximum = 2.5
step = 0.05

[sub_resource type="Resource" id="Row_look_sensitivity_y"]
script = ExtResource("1_row")
key = &"look_sensitivity_y"
label = "Look speed"
hint = "How fast the camera tilts up and down."
group = "Controls"
default_value = 1.0
minimum = 0.3
maximum = 2.5
step = 0.05

[sub_resource type="Resource" id="Row_invert_y"]
script = ExtResource("1_row")
key = &"invert_y"
label = "Invert vertical look"
hint = "Push down to look up."
group = "Controls"
kind = 0
default_value = 0.0

[sub_resource type="Resource" id="Row_stick_size"]
script = ExtResource("1_row")
key = &"stick_size"
label = "Stick size"
hint = "How far the thumb travels for a full push."
group = "Controls"
default_value = 1.0
minimum = 0.7
maximum = 1.45
step = 0.05

[sub_resource type="Resource" id="Row_stick_opacity"]
script = ExtResource("1_row")
key = &"stick_opacity"
label = "Stick visibility"
hint = "How strongly the sticks are drawn at rest."
group = "Controls"
default_value = 0.35
minimum = 0.1
maximum = 0.9
step = 0.05

[sub_resource type="Resource" id="Row_stick_offset_x"]
script = ExtResource("1_row")
key = &"stick_offset_x"
label = "Stick inset"
hint = "Moves both sticks in from the screen edges."
group = "Controls"
default_value = 0.0
minimum = -40.0
maximum = 90.0
step = 2.0
display_scale = 1.0
display_suffix = ""

[sub_resource type="Resource" id="Row_stick_offset_y"]
script = ExtResource("1_row")
key = &"stick_offset_y"
label = "Stick height"
hint = "Raises both sticks up from the bottom edge."
group = "Controls"
default_value = 0.0
minimum = -40.0
maximum = 90.0
step = 2.0
display_scale = 1.0
display_suffix = ""

[sub_resource type="Resource" id="Row_stick_deadzone"]
script = ExtResource("1_row")
key = &"stick_deadzone"
label = "Dead zone"
hint = "How far a thumb may rest before anything moves."
group = "Controls"
default_value = 0.09
minimum = 0.0
maximum = 0.35
step = 0.01

[sub_resource type="Resource" id="Row_haptics"]
script = ExtResource("1_row")
key = &"haptics"
label = "Haptics"
hint = "A short tap on interaction. Not every phone allows this from a browser."
group = "Controls"
kind = 0
default_value = 1.0

[sub_resource type="Resource" id="Row_volume_master"]
script = ExtResource("1_row")
key = &"volume_master"
label = "Master"
group = "Audio"
default_value = 0.85

[sub_resource type="Resource" id="Row_volume_sfx"]
script = ExtResource("1_row")
key = &"volume_sfx"
label = "Effects"
group = "Audio"
default_value = 1.0

