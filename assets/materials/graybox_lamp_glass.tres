[gd_resource type="StandardMaterial3D" format=3]

; The visible bulb of the sodium bulkhead lamp. Emissive so the light in the
; room always has a source you can look at -- a light with no fixture is the
; fastest way to make a scene read as an engine demo.
;
; The energy is 1.5 and not 2.6. That is the fix for the P0 defect where this
; panel clipped to flat white: at 2.6 the emissive was above the filmic curve's
; shoulder and lost its hue, and the post stack's thresholded bloom now does the
; work of making it read as bright without the surface itself having to be.
;
; Raising the environment's tonemap white point was the other candidate and was
; wrong: it dims the entire image to buy headroom for one surface, in a game
; whose problem is that it is already very dark.

[resource]
resource_name = "Graybox Lamp Glass"
albedo_color = Color(0.055, 0.036, 0.018, 1)
metallic = 0.0
roughness = 0.4
emission_enabled = true
emission = Color(1, 0.706, 0.42, 1)
emission_energy_multiplier = 1.5
