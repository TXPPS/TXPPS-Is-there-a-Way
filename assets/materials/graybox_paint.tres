[gd_resource type="ShaderMaterial" load_steps=3 format=3]

; Paint over red-oxide primer over steel. The chip edge is deliberately hard,
; because paint lifts, it does not fade -- but only a fifth of the surface has
; lifted. At half, a machine reads as camouflage rather than as neglect.
;
; No waterline: this is on plant, not on walls, and a tide mark across a
; switchboard is a tide mark nothing put there.

[ext_resource type="Shader" path="res://src/render/surface.gdshader" id="1_shader"]
